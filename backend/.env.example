# Local Postgres from docker-compose.yaml (host port 5433)
DATABASE_URL=postgresql+asyncpg://postpilot:postpilot@127.0.0.1:5433/postpilot
DATABASE_ECHO=false

# Origins allowed by CORS (JSON list). Vite dev server by default.
CORS_ORIGINS=["http://localhost:5173"]

# S3. Locally: LocalStack from docker-compose.yaml (test/test).
# In production: leave S3_ENDPOINT_URL empty and set the real bucket and IAM keys.
S3_BUCKET=postpilot-dev
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test


# Auth0 > Applications > APIs (domain without https://)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://postpilot.jonas-rocha.com/api
# Local only: requests without a token act as this user. Leave empty in production.
AUTH_DEV_USER=dev-user

# Logs: JSON on stdout (production). LOG_JSON=false for readable local logs.
LOG_LEVEL=INFO
LOG_JSON=false

# Production (Render), for reference:
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?ssl=require
#   CORS_ORIGINS=[]                (same origin through Vercel)
#   S3_ENDPOINT_URL=               (empty = real AWS)
#   AUTH_DEV_USER=                 (empty: always require a token)
#   LOG_JSON=true
